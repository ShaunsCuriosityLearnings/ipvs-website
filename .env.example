# IPVS 2026 - SMTP Configuration for Lead Delivery
# Enter your SMTP server details below to enable email dispatch to info@orbitexhibitions.com

# SMTP Server Host (e.g. mail.orbitexhibitions.com, smtp.gmail.com, smtp.office365.com)
SMTP_HOST=mail.orbitexhibitions.com

# SMTP Server Port (typically 587 for TLS, 465 for SSL, or 25)
SMTP_PORT=587

# SMTP Secure Connection (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP Username / Sender Email Address
SMTP_USER=info@orbitexhibitions.com

# SMTP Password or App Password
SMTP_PASS=your_smtp_password_here

# Display Name & Sender in From Header
SMTP_FROM="IPVS 2026 Lead Desk" <info@orbitexhibitions.com>

# Target email to receive all lead submissions
RECEIVER_EMAIL=info@orbitexhibitions.com

# -----------------------------------------------------------------------------
# Google Sheets Automation (via Google Apps Script Web App)
# Paste your deployed Google Apps Script Web App URL below
# See setup instructions in: scripts/google_apps_script.js
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
